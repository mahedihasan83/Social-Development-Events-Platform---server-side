# ── Server ──────────────────────────────────────────────────────────────
PORT=5000

# MongoDB Atlas connection string (Database Access → user credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shohojog

# Long random secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Google login credentials from Google Cloud Console (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
